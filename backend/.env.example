# Copy this file to backend/.env and fill in your own values.
# .env itself is gitignored - it never leaves your machine.

PORT=4000

# Origins allowed to call this API, comma-separated. Must match where the
# frontend actually runs, or the browser blocks the requests as cross-origin.
FRONTEND_URL=http://localhost:3200

# Pooled connection - the running app uses this one.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The same connection WITHOUT -pooler in the hostname. Prisma migrations need a
# direct connection; they fail through a pooler.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# Signs the session cookie. Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
